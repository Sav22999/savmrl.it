RewriteEngine On

# Allow alpha (development)
RewriteRule ^alpha/ - [L]

# Allow static assets
RewriteRule ^savmrl/ - [L]

# Block all API calls (production)
RewriteRule ^api/ /r/ [L]

# Block stats pages
RewriteRule ^stats/ /r/ [L]

# Block root account pages
RewriteRule ^account/ /r/ [L]

# Block admin pages
RewriteRule ^admin/ /r/ [L]

# All shortened links go through /r/ which shows suspension
ErrorDocument 404 /r/
ErrorDocument 403 /r/
